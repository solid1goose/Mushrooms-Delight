{
	"schemaVersion": 1,
	"id": "mushrooms-delight",
	"version": "${version}",
	"name": "Mushrooms Delight",
	"description": "An addon for farmers delight, adds new food related to mushrooms",
	"authors": [
		"IvanPunk"
	],
	"contact": {
		"sources": "https://github.com/solid1goose/Mushrooms-Delight.git"
	},
	"license": "MIT",
	"icon": "assets/mushrooms-delight/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ivan.mushroomsdelight.MushroomsDelight"
		],
		"client": [
			"ivan.mushroomsdelight.client.MushroomsDelightClient"
		],
		"fabric-datagen": [
			"ivan.mushroomsdelight.DataGenerate"
		]
	},
	"mixins": [
		"mushrooms-delight.mixins.json",
		{
			"config": "mushrooms-delight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"farmersdelight": ">=26.1-3.5.2+refabricated"
	}
}